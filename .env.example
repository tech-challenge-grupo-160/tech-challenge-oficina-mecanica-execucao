# Copie para .env (ignorado pelo Git). Os valores abaixo ja funcionam para
# rodar localmente; troque a senha se quiser, nos dois lugares.
POSTGRES_PASSWORD=defina-uma-senha-local
API_CONNECTION_STRING=Host=postgres;Database=oficina_execucao;Username=postgres;Password=defina-uma-senha-local

# O LocalStack (que sobe no compose do OS Service) aceita qualquer credencial.
LOCALSTACK_ACCESS_KEY_ID=test
LOCALSTACK_SECRET_ACCESS_KEY=test
